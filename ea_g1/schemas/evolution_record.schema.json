{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"EA-G1 EvolutionRecord","type":"object","required":["evolution_id","predecessor_record","triggering_evidence","prior_interpretation","new_interpretation","reason_for_change","change_classification","historical_record_preserved","provenance","historical_impact"],"properties":{"evolution_id":{"type":"string","minLength":1},"predecessor_record":{"type":"string","minLength":1},"triggering_evidence":{"type":"array","items":{"type":"string"}},"prior_interpretation":{"type":"string","minLength":1},"new_interpretation":{"type":"string","minLength":1},"reason_for_change":{"type":"string","minLength":1},"change_classification":{"enum":["ARCHITECTURAL","INTERPRETIVE","IMPLEMENTATION","EVIDENCE_STATUS","GOVERNANCE"]},"historical_record_preserved":{"const":true},"provenance":{"$ref":"provenance.schema.json"},"verification_state":{"enum":["VERIFIED","NOT_MEASURED","UNRESOLVED"]},"qualification_state":{"enum":["QUALIFIED","NOT_MEASURED","UNRESOLVED"]},"human_ratification_id":{"type":["string","null"]},"historical_impact":{"const":"NONE"}},"additionalProperties":true}